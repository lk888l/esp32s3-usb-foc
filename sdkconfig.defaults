CONFIG_IDF_TARGET="esp32s3"
# CONFIG_ESPTOOLPY_FLASHSIZE_4MB is not set
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ADC_CONTINUOUS_ISR_IRAM_SAFE=y
CONFIG_KNOB_PHASE_RESISTANCE_MILLIOHM=0
CONFIG_KNOB_HOST_LEASE_MS=0
CONFIG_MCPWM_ISR_CACHE_SAFE=y
CONFIG_MCPWM_CTRL_FUNC_IN_IRAM=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_KNOB_CONSOLE_USB=y
CONFIG_KNOB_PWM_20K65=y
CONFIG_KNOB_BUS_VOLTAGE_SENSE=y
CONFIG_KNOB_BUS_DIVIDER_MILLI=11000
CONFIG_ADC_ONESHOT_CTRL_FUNC_IN_IRAM=y
CONFIG_KNOB_ALLOW_WEAK_MAGNET=y

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Keep USB/protocol code cached alongside the IRAM-resident 5 kHz controller.
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
